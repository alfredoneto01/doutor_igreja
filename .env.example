# URL base do site — usado em metadataBase, canônicas, OG, sitemap e robots.
# Domínio definitivo ainda não decidido (contexto §13/§39).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Número de WhatsApp usado nos CTAs (E.164 sem sinais).
# Em homologação, use o NÚMERO DE TESTE. O número oficial (5511987837773) só
# entra com aprovação expressa do Cadu (contexto §40).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Indexação por buscadores. Deixe vazio em homologação; "true" só em produção.
NEXT_PUBLIC_ALLOW_INDEXING=
